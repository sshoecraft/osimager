{
  "plugin": "github.com/hashicorp/qemu",
  "arches": [
    "x86_64",
    "aarch64"
  ],
  "defs": {
    "libvirt_uri": ""
  },
  "platform_defs": {
    "firmware": "bios"
  },
  "post_build": "scripts/qemu_post_build.py",
  "config": {
    "type": "qemu",
    "iso_url": "E>'>>iso_path<</>>iso_name<<' if >>local_only<< else '>>iso_url<<'<E",
    "iso_checksum": "E>'>>iso_checksum<<' if len('>>iso_checksum<<') else 'none'<E",
    "iso_target_path": "E>'' if >>local_only<< else '>>iso_path<</>>iso_name<<'<E",
    "output_directory": ">>vms_path<</qemu/>>name<<",
    "shutdown_command": "echo 'packer' | sudo -S shutdown -P now",
    "sockets": "#>cpu_sockets<#",
    "cores": "#>cpu_cores<#",
    "firmware": "",
    "memory": "#>memory<#",
    "disk_size": ">>boot_disk_size<<M",
    "format": "qcow2",
    "accelerator": "E>'kvm' if os.access('/dev/kvm', os.W_OK) else 'none'<E",
    "cpu_model": "E>'host' if os.access('/dev/kvm', os.W_OK) else 'max'<E",
    "cd_files": "%>cd_files<%",
    "cd_label": ">>cd_label<<",
    "headless": true,
    "vm_name": ">>name<<",
    "net_device": "virtio-net",
    "disk_interface": "virtio"
  }
}
