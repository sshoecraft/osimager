{
  "plugin": "github.com/hashicorp/qemu",
  "include": "all",
  "arches": [
    "x86_64",
    "aarch64"
  ],
  "defs": {
    "local": true
  },
  "config": {
    "type": "qemu",
    "vm_name": ">>name<<",
    "output_directory": ">>vms_path<</libvirt/>>name<<",
    "iso_url": "E>'>>iso_path<</>>iso_name<<' if >>local_only<< else '>>iso_url<<'<E",
    "iso_checksum": "E>'>>iso_checksum<<' if len('>>iso_checksum<<') else 'none'<E",
    "iso_target_path": "E>'' if >>local_only<< else '>>iso_path<</>>iso_name<<'<E",
    "cd_files": "%>cd_files<%",
    "cd_label": ">>cd_label<<",
    "sockets": "#>cpu_sockets<#",
    "cores": "#>cpu_cores<#",
    "memory": "#>memory<#",
    "firmware": ">>firmware<<",
    "disk_size": ">>boot_disk_size<<M",
    "format": "qcow2",
    "accelerator": "kvm",
    "net_device": "virtio-net",
    "disk_interface": "virtio"
  }
}
