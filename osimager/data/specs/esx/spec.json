{
  "provides": {
    "dist": "esx",
    "versions": [
      "4.1U3"
    ]
  },
  "platforms": [
    "vmware",
    "vsphere"
  ],
  "arch_specific": [
    {
      "arch": "x86_64",
      "defs": {
        "iso_url": ">>iso_path<</ESX-4.1.0-update03-800380.iso"
      }
    }
  ],
  "defs": {
    "memory": 4096,
    "ansible_playbook": "config.yml"
  },
  "config": {
    "boot_wait": "10s",
    "boot_command": [
      "<enter>"
    ],
    "shutdown_command": "poweroff"
  },
  "platform_specific": [
    {
      "platform": "vmware",
      "config": {
        "guest_os_type": "vmkernel5",
        "disk_adapter_type": "lsisas1068",
        "network_adapter_type": "e1000"
      }
    },
    {
      "platform": "vsphere",
      "config": {
        "guest_os_type": "vmkernel5Guest",
        "disk_controller_type": "lsilogic-sas",
        "network_adapters": [
          {
            "network": ">>vm_network<<",
            "network_card": "e1000"
          }
        ]
      }
    }
  ]
}
