{
  "provides": {
    "dist": "xcpng",
    "versions": [
      "8.2.1"
    ]
  },
  "include": "linux",
  "platforms": [
    "virtualbox",
    "vmware",
    "qemu",
    "libvirt",
    "none"
  ],
  "files": [
    {
      "sources": [
        "xcpng/answerfile.xml"
      ],
      "dest": "answerfile.xml"
    }
  ],
  "arch_specific": [
    {
      "arch": "x86_64",
      "defs": {
        "iso_url": "file://>>iso_path<</xcp-ng->>version<<-20231130.iso"
      }
    }
  ],
  "defs": {
    "boot_disk_size": 65536,
    "memory": 4096,
    "cd_files": ">>temp_dir<</answerfile.xml",
    "cd_label": "OEMDRV"
  },
  "config": {
    "boot_wait": "10s",
    "boot_command": [
      "<tab> answerfile=cdrom:/answerfile.xml<enter>"
    ],
    "shutdown_command": "/sbin/shutdown -P now"
  },
  "platform_specific": [
    {
      "platform": "virtualbox",
      "config": {
        "guest_os_type": "RedHat7_64"
      }
    },
    {
      "platform": "vmware",
      "config": {
        "guest_os_type": "centos7-64"
      }
    }
  ]
}
