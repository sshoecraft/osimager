{
  "provides": {
    "dist": "mint",
    "versions": [
      "22.2"
    ]
  },
  "ansible_version": "2.18",
  "include": "linux",
  "platforms": [
    "virtualbox",
    "vmware",
    "vsphere",
    "proxmox",
    "qemu",
    "hyperv",
    "none"
  ],
  "defs": {
    "boot_disk_size": 32768,
    "cd_files": ">>temp_dir<</ubuntu.seed",
    "cd_label": "media"
  },
  "config": {
    "boot_wait": "30s",
    "shutdown_command": "/sbin/shutdown -P now",
    "boot_command": [
      "<esc><wait>",
      "c<wait>",
      "linux /casper/vmlinuz auto=true priority=critical automatic-ubiquity",
      " preseed/file=/media/ubuntu.seed net.ifnames=0 biosdevname=0 ---<enter>",
      "initrd /casper/initrd.lz<enter>",
      "boot<enter>",
      "<wait10><wait10>",
      "<leftAltOn><f2><leftAltOff><enter><wait>",
      "mount $(blkid | grep >>cd_label<< | cut -d: -f1) /media<enter>",
      "<leftAltOn><f1><leftAltOff>"
    ]
  },
  "files": [
    {
      "sources": [
        "ubuntu/ubuntu.seed"
      ],
      "dest": "ubuntu.seed"
    }
  ],
  "version_specific": [
    {
      "version": "22\\.2",
      "arch_specific": [
        { "arch": "x86_64", "defs": { "iso_url": "https://mirrors.edge.kernel.org/linuxmint/stable/>>version<</linuxmint->>version<<-cinnamon-64bit.iso" } }
      ],
      "platform_specific": [
        { "platform": "virtualbox", "config": { "guest_os_type": "Ubuntu_64" } },
        { "platform": "vmware", "config": { "guest_os_type": "ubuntu-64" } },
        { "platform": "vsphere", "config": { "guest_os_type": "ubuntu64Guest" } }
      ]
    }
  ]
}
