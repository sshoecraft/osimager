{
  "provides": {
    "dist": "omnios",
    "versions": [
      "r151052"
    ]
  },
  "ansible_version": "2.18",
  "include": "ssh",
  "platforms": [
    "qemu",
    "proxmox",
    "vmware",
    "none"
  ],
  "defs": {
    "boot_disk_size": 16384,
    "memory": 2048,
    "spec_config": "tasks/spec.yml"
  },
  "variables": {
    "ssh-username": "root",
    "ssh-password": "{{vault `images/linux` `password`}}"
  },
  "config": {
    "shutdown_command": "shutdown -y -i5 -g0"
  },
  "version_specific": [
    {
      "version": "r151052",
      "arch_specific": [
        { "arch": "x86_64", "defs": { "disk_image_url": "file://>>iso_path<</omnios/omnios->>version<<.qcow2" } }
      ]
    }
  ]
}
