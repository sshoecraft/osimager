{
  "provides": {
    "dist": "solaris",
    "versions": [
      "11.4"
    ]
  },
  "ansible_version": "2.18",
  "include": "ssh",
  "platforms": [
    "qemu",
    "vmware",
    "virtualbox",
    "none"
  ],
  "defs": {
    "boot_disk_size": 32768,
    "memory": 4096,
    "spec_config": "tasks/spec.yml"
  },
  "variables": {
    "ssh-username": "root",
    "ssh-password": "{{vault `images/linux` `password`}}"
  },
  "config": {
    "shutdown_command": "shutdown -y -i5 -g0"
  },
  "version_specific": [
    {
      "version": "11\\.4",
      "arch_specific": [
        { "arch": "x86_64", "defs": { "disk_image_url": "file://>>iso_path<</solaris/sol->>version<<-x86.ova" } }
      ]
    }
  ]
}
