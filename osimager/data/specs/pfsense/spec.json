{
  "provides": {
    "dist": "pfsense",
    "versions": [
      "2.7.2"
    ]
  },
  "ansible_version": "2.18",
  "include": "ssh",
  "platforms": [
    "qemu",
    "proxmox",
    "vmware",
    "virtualbox",
    "none"
  ],
  "defs": {
    "boot_disk_size": 16384,
    "memory": 2048,
    "spec_config": "tasks/spec.yml"
  },
  "variables": {
    "ssh-username": "admin",
    "ssh-password": "{{vault `images/linux` `password`}}"
  },
  "config": {
    "shutdown_command": "/sbin/shutdown -p now"
  },
  "version_specific": [
    {
      "version": "2\\.7\\.2",
      "arch_specific": [
        { "arch": "x86_64", "defs": { "iso_url": "file://>>iso_path<</pfSense/pfSense-CE->>version<<-RELEASE-amd64.iso" } }
      ]
    }
  ]
}
