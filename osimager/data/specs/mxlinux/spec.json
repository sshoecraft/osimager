{
  "provides": {
    "dist": "mxlinux",
    "versions": [
      "23.5",
      "23.6"
    ]
  },
  "ansible_version": "2.18",
  "include": "linux",
  "platforms": [
    "virtualbox",
    "vmware",
    "proxmox",
    "qemu",
    "none"
  ],
  "defs": {
    "boot_disk_size": 16384
  },
  "config": {
    "boot_wait": "10s",
    "boot_command": [
      "<enter>"
    ],
    "shutdown_command": "/sbin/shutdown -P now"
  },
  "platform_specific": [
    {
      "platform": "virtualbox",
      "config": {
        "guest_os_type": "Debian_64"
      }
    },
    {
      "platform": "vmware",
      "config": {
        "guest_os_type": "debian12-64"
      }
    }
  ],
  "version_specific": [
    {
      "version": "23\\.5",
      "arch_specific": [
        {
          "arch": "x86_64",
          "defs": {
            "iso_url": "file://>>iso_path<</MX->>version<<_x64.iso"
          }
        }
      ]
    },
    {
      "version": "23\\.6",
      "arch_specific": [
        { "arch": "x86_64", "defs": { "iso_url": "https://downloads.sourceforge.net/project/mx-linux/Old/MX->>version<</Xfce/MX->>version<<_x64.iso" } }
      ]
    }
  ]
}
