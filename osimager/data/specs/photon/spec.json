{
  "provides": {
    "dist": "photon",
    "versions": [
      "5.0"
    ]
  },
  "ansible_version": "2.18",
  "include": "linux",
  "platforms": [
    "virtualbox",
    "vmware",
    "vsphere",
    "proxmox",
    "qemu",
    "none"
  ],
  "files": [
    {
      "sources": [
        "photon/kickstart.json"
      ],
      "dest": "photon-kickstart.json"
    }
  ],
  "defs": {
    "boot_disk_size": 16384,
    "memory": 2048,
    "cd_files": ">>temp_dir<</photon-kickstart.json",
    "cd_label": "OEMDRV"
  },
  "config": {
    "boot_wait": "10s",
    "shutdown_command": "/sbin/shutdown -P now",
    "boot_command": [
      "<up>e",
      "<down><down><end>",
      " ks=cdrom:/photon-kickstart.json photon.media=cdrom insecure_installation=1 net.ifnames=0 biosdevname=0",
      "<leftCtrlOn>x<leftCtrlOff>"
    ]
  },
  "version_specific": [
    {
      "version": "5\\.0",
      "arch_specific": [
        { "arch": "x86_64", "defs": { "iso_url": "https://packages.broadcom.com/photon/>>version<</GA/iso/photon->>version<<-dde71ec57.x86_64.iso" } },
        { "arch": "aarch64", "defs": { "iso_url": "https://packages.broadcom.com/photon/>>version<</GA/iso/photon->>version<<-dde71ec57.aarch64.iso" } }
      ],
      "platform_specific": [
        {
          "platform": "virtualbox",
          "config": {
            "guest_os_type": "Linux_64"
          }
        },
        {
          "platform": "vmware",
          "config": {
            "guest_os_type": "vmwarePhoton64"
          }
        },
        {
          "platform": "vsphere",
          "config": {
            "guest_os_type": "vmwarePhoton64Guest"
          }
        }
      ]
    }
  ]
}
