{
  "provides": {
    "dist": "opnsense",
    "versions": [
      "25.7"
    ]
  },
  "ansible_version": "2.18",
  "include": "ssh",
  "platforms": [
    "qemu",
    "proxmox",
    "vmware",
    "none"
  ],
  "defs": {
    "boot_disk_size": 16384,
    "memory": 2048,
    "spec_config": "tasks/spec.yml"
  },
  "variables": {
    "ssh-username": "root",
    "ssh-password": "{{vault `images/linux` `password`}}"
  },
  "config": {
    "shutdown_command": "/sbin/shutdown -p now"
  },
  "version_specific": [
    {
      "version": "25\\.7",
      "arch_specific": [
        { "arch": "x86_64", "defs": { "disk_image_url": "file://>>iso_path<</OPNsense->>version<<-vm-amd64.img" } }
      ]
    }
  ]
}
