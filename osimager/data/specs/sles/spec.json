{
  "provides": {
    "dist": "sles",
    "versions": [
        "12.[1-5]",
        "15.[0-7]",
        "16.[0-0]"
    ]
  },
  "include": "linux",
  "platforms": [
    "virtualbox",
    "vmware",
    "vsphere",
    "proxmox",
    "qemu",
    "xenserver",
    "hyperv",
    "azure",
    "gcp",
    "aws",
    "none"
  ],
  "defs": {
    "boot_disk_size": 32768,
    "timezone": "America/Chicago",
    "cd_files": ">>temp_dir<</autoinst.xml",
    "cd_label": "OEMDRV"
  },
  "config": {
    "boot_wait": "10s",
    "shutdown_command": "/sbin/shutdown -P now",
    "boot_command": [
      "<down><wait>textmode=1",
      " autoyast=device://OEMDRV/autoinst.xml",
      " net.ifnames=0 biosdevname=0",
      "<enter>"
    ]
  },
  "version_specific": [
    {
      "version": "12.*",
      "ansible_version": "2.16",
      "arch_specific": [
        {
          "arch": "x86_64",
          "defs": {
            "iso_url": "file://>>iso_path<</SUSE/SLE-12-SP>>minor<<-Server-DVD-x86_64-GM-DVD1.iso"
          }
        }
      ],
      "defs": {
        "iso_url": "",
        "ansible_extra_vars": "ansible_python_interpreter=/usr/bin/python"
      },
      "files": [
        {
          "sources": [
            "sles/autoinst_12.xml"
          ],
          "dest": "autoinst.xml"
        }
      ],
      "platform_specific": [
        {
          "platform": "virtualbox",
          "config": {
            "guest_os_type": "OpenSUSE_64"
          }
        },
        {
          "platform": "vmware",
          "config": {
            "guest_os_type": "sles12-64"
          }
        },
        {
          "platform": "vsphere",
          "config": {
            "guest_os_type": "sles12_64Guest"
          }
        }
      ]
    },
    {
      "version": "15.*",
      "ansible_version": "2.16",
      "arch_specific": [
        { "arch": "x86_64", "defs": { "iso_url": "file://>>iso_path<</SUSE/SLE-15-SP>>minor<<-Full-x86_64-GM-Media1.iso" } },
        { "arch": "aarch64", "defs": { "iso_url": "file://>>iso_path<</SUSE/SLE-15-SP>>minor<<-Full-aarch64-GM-Media1.iso" } }
      ],
      "defs": {
        "iso_url": "",
        "ansible_extra_vars": "ansible_python_interpreter=/usr/bin/python3",
        "azure_image_publisher": "SUSE",
        "azure_image_offer": "sles-15-sp>>minor<<",
        "azure_image_sku": "gen2",
        "gcp_source_image_family": "sles-15",
        "gcp_source_image_project_id": "suse-cloud",
        "gcp_image_family": "sles-15",
        "aws_ami_filter_name": "suse-sles-15-sp>>minor<<-*-hvm-ssd-x86_64",
        "aws_ami_owners": ["013907871322"]
      },
      "files": [
        {
          "sources": [
            "sles/autoinst_15.xml"
          ],
          "dest": "autoinst.xml"
        }
      ],
      "platform_specific": [
        {
          "platform": "virtualbox",
          "config": {
            "guest_os_type": "OpenSUSE_64"
          }
        },
        {
          "platform": "vmware",
          "config": {
            "guest_os_type": "sles15-64"
          }
        },
        {
          "platform": "vsphere",
          "config": {
            "guest_os_type": "sles15_64Guest"
          }
        }
      ]
    },
    {
      "version": "15.0",
      "arch_specific": [
        { "arch": "x86_64", "defs": { "iso_url": "file://>>iso_path<</SUSE/SLE-15-Full-x86_64-GM-Media1.iso" } },
        { "arch": "aarch64", "defs": { "iso_url": "file://>>iso_path<</SUSE/SLE-15-Full-aarch64-GM-Media1.iso" } }
      ]
    },
    {
      "version": "16.*",
      "ansible_version": "2.18",
      "method": "replace",
      "arch_specific": [
        { "arch": "x86_64", "defs": { "iso_url": "file://>>iso_path<</SUSE/SLE-16-SP>>minor<<-Full-x86_64-GM-Media1.iso" } },
        { "arch": "aarch64", "defs": { "iso_url": "file://>>iso_path<</SUSE/SLE-16-SP>>minor<<-Full-aarch64-GM-Media1.iso" } }
      ],
      "defs": {
        "iso_url": "",
        "cd_files": ">>temp_dir<</agama-install.json",
        "ansible_extra_vars": "ansible_python_interpreter=/usr/bin/python3"
      },
      "config": {
        "boot_command": [
          "<down><wait>inst.auto=device://OEMDRV/agama-install.json",
          " net.ifnames=0 biosdevname=0",
          "<enter>"
        ]
      },
      "files": [
        {
          "sources": [
            "agama/sles.json"
          ],
          "dest": "agama-install.json"
        }
      ],
      "platform_specific": [
        {
          "platform": "virtualbox",
          "config": {
            "guest_os_type": "OpenSUSE_64"
          }
        },
        {
          "platform": "vmware",
          "config": {
            "guest_os_type": "sles16-64"
          }
        },
        {
          "platform": "vsphere",
          "config": {
            "guest_os_type": "sles16_64Guest"
          }
        }
      ]
    }
  ]
}
