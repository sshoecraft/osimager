{
  "provides": {
    "dist": "openindiana",
    "versions": [
      "hipster"
    ]
  },
  "ansible_version": "2.18",
  "include": "ssh",
  "platforms": [
    "qemu",
    "vmware",
    "virtualbox",
    "none"
  ],
  "defs": {
    "boot_disk_size": 16384,
    "memory": 2048,
    "spec_config": "tasks/spec.yml"
  },
  "variables": {
    "ssh-username": "root",
    "ssh-password": "{{vault `images/linux` `password`}}"
  },
  "config": {
    "shutdown_command": "shutdown -y -i5 -g0"
  },
  "version_specific": [
    {
      "version": "hipster",
      "arch_specific": [
        { "arch": "x86_64", "defs": { "iso_url": "file://>>iso_path<</OI-hipster-text-x86.iso" } }
      ]
    }
  ]
}
