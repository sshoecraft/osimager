{
  "provides": {
    "dist": "vyos",
    "versions": [
      "1.4"
    ]
  },
  "ansible_version": "2.18",
  "include": "ssh",
  "platforms": [
    "qemu",
    "proxmox",
    "vmware",
    "none"
  ],
  "defs": {
    "boot_disk_size": 16384,
    "memory": 2048,
    "spec_config": "tasks/spec.yml"
  },
  "variables": {
    "ssh-username": "vyos",
    "ssh-password": "{{vault `images/linux` `password`}}"
  },
  "config": {
    "shutdown_command": "poweroff"
  },
  "version_specific": [
    {
      "version": "1\\.4",
      "arch_specific": [
        { "arch": "x86_64", "defs": { "disk_image_url": "file://>>iso_path<</vyos/vyos->>version<<-generic-amd64.qcow2" } }
      ]
    }
  ]
}
