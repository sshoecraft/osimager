{
  "variables": {
    "platform": "vmware"
  },
  "builders": [
    {
      "name": "adserver",
      "type": "vmware-iso",
      "guest_os_type": "windows2019srvnext-64",
      "vm_name": "{{build_name}}",
      "output_directory": "/vms/vmware/{{build_name}}",
      "headless": false,
      "skip_export": true,
      "keep_registered": true,
      "skip_compaction": true,
      "insecure_connection": true,
      "shutdown_command": "shutdown /s /t 0 /d p:0:0 /c \"Packer Shutdown\"",
      "cpus": 1,
      "cores": 2,
      "memory": 4096,
      "usb": true,
      "iso_url": "/iso/Windows/SW_DVD9_Win_Server_STD_CORE_2022_2108.4_64Bit_English_DC_STD_MLF_X22-98396.ISO",
      "iso_checksum": "none",
      "floppy_files": [
        "Autounattend.xml"
      ],
      "cd_label": "packer",
      "boot_wait": "3s",
      "boot_command": [ "<enter>" ],
      "disk_type_id": 0,
      "vmdk_name": "{{build_name}}",
      "disk_size": 32768,
      "vmx_data": {
	"virtualhw.version": "21",
	"scsi0.virtualdev": "pvscsi",
	"ethernet0.virtualdev": "vmxnet3",
        "ethernet0.present": "TRUE",
        "ethernet0.startConnected": "TRUE",
        "ethernet0.connectiontype": "custom",
        "ethernet0.vnet": "/dev/vmnet0",
        "remotedisplay.vnc.ip": "192.168.120.1"
      },
      "communicator": "winrm",
      "winrm_host": "192.168.120.2",
      "winrm_port": "5985",
      "winrm_use_ssl": false,
      "winrm_insecure": true,
      "winrm_username": "Administrator",
      "winrm_password": "Ch@ng3m3!",
      "winrm_timeout": "4h"
    },
    {
      "name": "esxhost",
      "type": "vmware-iso",
      "guest_os_type": "vmkernel8",
      "vm_name": "{{build_name}}",
      "output_directory": "/vms/vmware/{{build_name}}",
      "headless": false,
      "skip_export": true,
      "keep_registered": true,
      "skip_compaction": true,
      "insecure_connection": true,
      "shutdown_command": "/sbin/halt -h -p",
      "firmware": "efi",
      "cpus": 4,
      "memory": 12288,
      "usb": true,
      "iso_url": "/iso/VMware/VMware-VMvisor-Installer-8.0U2-22380479.x86_64.iso",
      "iso_checksum": "none",
      "cd_files": [
        "ks.cfg"
      ],
      "cd_label": "OEMDRV",
      "boot_wait": "5s",
      "boot_command": [
        "<enter><wait>O ks=cdrom:/KS.CFG<enter>"
      ],
      "communicator": "ssh",
      "ssh_host": "esxhost.vm.localdomain",
      "ssh_username": "root",
      "ssh_password": "Ch@ng3m3!",
      "ssh_clear_authorized_keys": true,
      "ssh_timeout": "25m",
      "ssh_disable_agent_forwarding": false,
      "vmdk_name": "{{build_name}}",
      "disk_type_id": 0,
      "disk_size": 8192,
      "vmx_data": {
	"virtualhw.version": "21",
	"scsi0.virtualdev": "pvscsi",
	"ethernet0.virtualdev": "vmxnet3",
        "ethernet0.present": "TRUE",
        "ethernet0.startConnected": "TRUE",
        "ethernet0.connectiontype": "custom",
        "ethernet0.vnet": "/dev/vmnet0",
        "remotedisplay.vnc.ip": "192.168.120.1",
